{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/balbuena-group/pace-s/contracts/kmc_interface.schema.json",
  "title": "PACE-S -> kMC 3D interface",
  "description": "One electrolyte evaluated by PACE-S, with everything the 3D kMC morphology model needs. Frozen in week 0. Changing this schema requires bumping schema_version and updating src/pace_s/export/kmc3d_adapter.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "electrolyte_id",
    "system",
    "composition",
    "solvation",
    "polysulfide",
    "interphase",
    "kinetics",
    "provenance"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "electrolyte_id": {
      "type": "string",
      "pattern": "^PACES-[0-9]{4,}$",
      "description": "Unique, stable identifier of the electrolyte (a formulation, not a molecule)."
    },
    "system": { "type": "string", "enum": ["Li-S", "Li-SPAN"] },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solvent", "diluent", "salt", "molar_ratio"],
      "properties": {
        "solvent": { "type": "string", "description": "Canonical SMILES of the coordinating solvent." },
        "diluent": {
          "type": ["string", "null"],
          "description": "Canonical SMILES of the diluent; null if there is none."
        },
        "salt": { "type": "string", "enum": ["LiFSI", "LiTFSI"] },
        "molar_ratio": {
          "type": "array",
          "description": "[salt, solvent, diluent], in relative moles.",
          "items": { "type": "number", "minimum": 0 },
          "minItems": 3,
          "maxItems": 3
        },
        "temperature_K": { "type": "number", "default": 298.15 }
      }
    },
    "solvation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["CN_Li_O", "frac_SSIP", "frac_CIP", "frac_AGG", "D_Li", "sigma_mS_cm"],
      "properties": {
        "CN_Li_O": { "type": "number", "minimum": 0, "description": "First-shell Li-O (solvent) coordination number." },
        "CN_Li_Oanion": { "type": "number", "minimum": 0, "description": "Li-O (anion) coordination number." },
        "frac_SSIP": { "type": "number", "minimum": 0, "maximum": 1 },
        "frac_CIP": { "type": "number", "minimum": 0, "maximum": 1 },
        "frac_AGG": { "type": "number", "minimum": 0, "maximum": 1 },
        "D_Li": { "type": "number", "minimum": 0, "description": "Li+ diffusion coefficient in m^2/s." },
        "sigma_mS_cm": {
          "type": "number",
          "minimum": 0,
          "description": "Ionic conductivity in mS/cm. LIMITATION: a Nernst-Einstein estimate overestimates it; state the method in provenance.notes."
        },
        "viscosity_mPa_s": { "type": "number", "minimum": 0 },
        "density_g_cm3": { "type": "number", "minimum": 0 },
        "residence_time_ps": { "type": "number", "minimum": 0, "description": "Solvent-Li+ residence time." }
      }
    },
    "polysulfide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solubility_Li2S8_mM", "method"],
      "properties": {
        "solubility_Li2S8_mM": {
          "type": "number",
          "minimum": 0,
          "description": "Li2S8 solubility in mM of S atoms, comparable with Table 1 of Joule 2021."
        },
        "binding_energy_Li2S8_eV": { "type": "number", "description": "Solvent-Li2S8 interaction energy (tier 0/2)." },
        "method": {
          "type": "string",
          "enum": ["tier0_binding", "tier1_pmf", "tier2_dft_cosmo", "experimental"],
          "description": "How the solubility was obtained."
        }
      }
    },
    "interphase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["species", "inorganic_fraction"],
      "properties": {
        "species": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["formula", "rel_abundance"],
            "properties": {
              "formula": { "type": "string" },
              "rel_abundance": { "type": "number", "minimum": 0, "maximum": 1 },
              "formation_energy_eV": { "type": "number" }
            }
          }
        },
        "inorganic_fraction": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "kinetics": {
      "type": "object",
      "description": "The three required fields are the input of the 3D kMC.",
      "additionalProperties": false,
      "required": ["desolvation_barrier_eV", "reduction_onset_V", "surface_diffusion_barrier_eV"],
      "properties": {
        "desolvation_barrier_eV": { "type": "number", "minimum": 0 },
        "reduction_onset_V": { "type": "number", "description": "Reduction onset potential vs Li/Li+." },
        "surface_diffusion_barrier_eV": { "type": "number", "minimum": 0 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "level_of_theory", "campaign_id", "commit"],
      "properties": {
        "tier": { "type": "integer", "minimum": 1, "maximum": 3, "description": "Highest tier backing the numbers in this record. Tier 0 is never exported." },
        "level_of_theory": { "type": "string", "description": "e.g. wB97X-D/def2-TZVPD, MACE-OMol-0, PBE-D3." },
        "mlip": { "type": "string", "description": "Potential used in tier 1, if any." },
        "campaign_id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{2,}$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "generated_at": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      }
    }
  }
}

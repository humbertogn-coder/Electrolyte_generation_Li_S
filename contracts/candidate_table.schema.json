{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/balbuena-group/pace-s/contracts/candidate_table.schema.json",
  "title": "PACE-S candidate table row",
  "description": "One row of the master candidate table (one molecule, not a formulation). Serialized as CSV/Parquet with dot-flattened columns (e.g. tier0.homo_eV). Frozen in week 0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "smiles",
    "canonical_smiles",
    "inchikey",
    "role",
    "generation",
    "campaign_id"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "candidate_id": {
      "type": "string",
      "pattern": "^PSM-[0-9]{6}$",
      "description": "PACE-S Molecule. Distinct from electrolyte_id (PACES-xxxx), which identifies a formulation."
    },
    "smiles": { "type": "string", "description": "SMILES as produced by the generator." },
    "canonical_smiles": { "type": "string", "description": "RDKit canonical SMILES; deduplication key." },
    "inchikey": { "type": "string", "pattern": "^[A-Z]{14}-[A-Z]{10}-[A-Z]$" },
    "role": { "type": "string", "enum": ["solvent", "diluent", "seed_solvent", "seed_diluent"] },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "parent_id", "operator"],
      "properties": {
        "stage": {
          "type": "integer",
          "enum": [0, 1, 2],
          "description": "0 = seed; 1 = enumerative variation of known molecules; 2 = open mutation (SAFE/REINVENT4)."
        },
        "parent_id": { "type": ["string", "null"], "description": "candidate_id of the parent; null for seeds." },
        "operator": {
          "type": ["string", "null"],
          "enum": [
            null,
            "seed",
            "h_to_f",
            "chain_extend",
            "chain_contract",
            "heteroatom_swap",
            "ring_open",
            "ring_close",
            "bridge_insert",
            "branch",
            "safe_decorate",
            "reinvent"
          ]
        },
        "distance_to_seeds": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "1 - maximum Tanimoto similarity to the seeds (Morgan r=2). Reported with every prediction."
        }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passes_hard": { "type": "boolean" },
        "hard_fail_reason": { "type": ["string", "null"] },
        "sascore": { "type": "number", "minimum": 1, "maximum": 10 },
        "rascore": { "type": "number", "minimum": 0, "maximum": 1 },
        "in_pubchem": { "type": ["boolean", "null"] },
        "in_emolecules": { "type": ["boolean", "null"] },
        "mp_est_C": { "type": "number" },
        "bp_est_C": { "type": "number" }
      }
    },
    "tier0": {
      "type": "object",
      "description": "Cheap descriptors (< 5 CPU-min). ONLY for ranking and filtering; they never enter the paper.",
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string", "description": "e.g. GFN2-xTB/ALPB, g-xTB." },
        "homo_eV": { "type": "number" },
        "lumo_eV": { "type": "number" },
        "gap_eV": { "type": "number" },
        "esp_max_kcal_mol": { "type": "number" },
        "esp_min_kcal_mol": { "type": "number" },
        "li_binding_eV": { "type": "number", "description": "Li+-solvent binding energy (donor-number proxy)." },
        "li2s8_binding_eV": { "type": "number", "description": "Central descriptor: solvent-Li2S8 interaction energy, calibrated against Table 1 of Joule 2021." },
        "solv_energy_kcal_mol": { "type": "number" },
        "dipole_D": { "type": "number" },
        "volume_A3": { "type": "number" },
        "tpsa_A2": { "type": "number" },
        "logp": { "type": "number" },
        "mol_weight": { "type": "number" },
        "frac_fluorination": { "type": "number", "minimum": 0, "maximum": 1, "description": "F / (F + H)." },
        "ratio_C_O": { "type": "number" },
        "n_conformers": { "type": "integer", "minimum": 0 },
        "n_li_sites": { "type": "integer", "minimum": 0, "description": "O/N/S sites tried for Li+ and Li2S8." },
        "wall_s": { "type": "number", "minimum": 0, "description": "Wall time of the calculation, in seconds." },
        "error": { "type": ["string", "null"], "description": "Message if the calculation failed; null otherwise." }
      }
    },
    "tier1": {
      "type": "object",
      "description": "MLIP-MD summary for this molecule's reference formulation; the detail lives in the PACES-xxxx record.",
      "additionalProperties": false,
      "properties": {
        "electrolyte_id": { "type": "string", "pattern": "^PACES-[0-9]{4,}$" },
        "mlip": { "type": "string" },
        "frac_CIP_AGG": { "type": "number", "minimum": 0, "maximum": 1 },
        "solubility_Li2S8_mM": { "type": "number", "minimum": 0 },
        "sigma_mS_cm": { "type": "number", "minimum": 0 },
        "viscosity_mPa_s": { "type": "number", "minimum": 0 }
      }
    },
    "tier2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level_of_theory": { "type": "string" },
        "reduction_potential_V": { "type": "number" },
        "oxidation_potential_V": { "type": "number" },
        "li_binding_eV": { "type": "number" },
        "li2s8_binding_eV": { "type": "number" },
        "desolvation_barrier_eV": { "type": "number" }
      }
    },
    "scores": {
      "type": "object",
      "description": "Objectives O1-O5 as seen by the acquisition loop, already in the 'higher is better' direction.",
      "additionalProperties": false,
      "properties": {
        "O1_weak_solvation": { "type": "number" },
        "O2_polysulfide_retention": { "type": "number" },
        "O3_reductive_passivation": { "type": "number" },
        "O4_transport": { "type": "number" },
        "O5_synthesizability": { "type": "number" },
        "pareto_rank": { "type": "integer", "minimum": 0 },
        "acquisition_value": { "type": "number" }
      }
    },
    "status": {
      "type": "string",
      "enum": ["generated", "filtered_out", "tier0_done", "selected", "tier1_done", "tier2_done", "tier3_done", "exported"]
    },
    "campaign_id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{2,}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
  }
}
